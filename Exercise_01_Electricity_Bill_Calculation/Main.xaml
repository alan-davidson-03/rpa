  <Sequence DisplayName="Main Sequence - Electricity Bill Calculation" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="strUnits" />
      <Variable x:TypeArguments="x:Int32" Name="intUnits" />
      <Variable x:TypeArguments="x:Double" Default="[0]" Name="dblBill" />
      <Variable x:TypeArguments="x:String" Name="strCategory" />
    </Sequence.Variables>
    <ui:InputDialog Options="{x:Null}" OptionsString="{x:Null}" DisplayName="Input Dialog - Enter Units" sap2010:WorkflowViewState.IdRef="InputDialog_1" IsPassword="False" Label="Enter electricity units consumed" Title="Electricity Bill Calculation">
      <ui:InputDialog.Result>
        <OutArgument x:TypeArguments="x:String">[strUnits]</OutArgument>
      </ui:InputDialog.Result>
    </ui:InputDialog>
    <Assign DisplayName="Convert Units to Int32" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Int32">[intUnits]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Int32">[Convert.ToInt32(strUnits)]</InArgument>
      </Assign.Value>
    </Assign>
    <If Condition="[intUnits &lt; 0]" DisplayName="If intUnits &lt; 0" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Sequence DisplayName="Invalid Branch" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <ui:MessageBox Caption="{x:Null}" ChosenButton="{x:Null}" AutoCloseAfter="00:00:00" DisplayName="Message Box - Invalid Units" sap2010:WorkflowViewState.IdRef="MessageBox_1" Text="[&quot;Invalid Units&quot;]" />
        </Sequence>
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Valid Branch" sap2010:WorkflowViewState.IdRef="Sequence_3">
          <If Condition="[intUnits &lt;= 100]" DisplayName="If intUnits &lt;= 100" sap2010:WorkflowViewState.IdRef="If_2">
            <If.Then>
              <Sequence DisplayName="Low Consumption Branch" sap2010:WorkflowViewState.IdRef="Sequence_4">
                <Assign DisplayName="Assign Bill - Low" sap2010:WorkflowViewState.IdRef="Assign_2">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:Double">[dblBill]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:Double">[intUnits * 2]</InArgument>
                  </Assign.Value>
                </Assign>
                <Assign DisplayName="Assign Category - Low" sap2010:WorkflowViewState.IdRef="Assign_3">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:String">[strCategory]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">["Low Consumption"]</InArgument>
                  </Assign.Value>
                </Assign>
              </Sequence>
            </If.Then>
            <If.Else>
              <If Condition="[intUnits &lt;= 200]" DisplayName="If intUnits &lt;= 200" sap2010:WorkflowViewState.IdRef="If_3">
                <If.Then>
                  <Sequence DisplayName="Moderate Consumption Branch" sap2010:WorkflowViewState.IdRef="Sequence_5">
                    <Assign DisplayName="Assign Bill - Moderate" sap2010:WorkflowViewState.IdRef="Assign_4">
                      <Assign.To>
                        <OutArgument x:TypeArguments="x:Double">[dblBill]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="x:Double">[intUnits * 3]</InArgument>
                      </Assign.Value>
                    </Assign>
                    <Assign DisplayName="Assign Category - Moderate" sap2010:WorkflowViewState.IdRef="Assign_5">
                      <Assign.To>
                        <OutArgument x:TypeArguments="x:String">[strCategory]</OutArgument>
                      </Assign.To>
                      <Assign.Value>
                        <InArgument x:TypeArguments="x:String">["Moderate Consumption"]</InArgument>
                      </Assign.Value>
                    </Assign>
                  </Sequence>
                </If.Then>
                <If.Else>
                  <If Condition="[intUnits &lt;= 300]" DisplayName="If intUnits &lt;= 300" sap2010:WorkflowViewState.IdRef="If_4">
                    <If.Then>
                      <Sequence DisplayName="High Consumption Branch" sap2010:WorkflowViewState.IdRef="Sequence_6">
                        <Assign DisplayName="Assign Bill - High" sap2010:WorkflowViewState.IdRef="Assign_6">
                          <Assign.To>
                            <OutArgument x:TypeArguments="x:Double">[dblBill]</OutArgument>
                          </Assign.To>
                          <Assign.Value>
                            <InArgument x:TypeArguments="x:Double">[intUnits * 5]</InArgument>
                          </Assign.Value>
                        </Assign>
                        <Assign DisplayName="Assign Category - High" sap2010:WorkflowViewState.IdRef="Assign_7">
                          <Assign.To>
                            <OutArgument x:TypeArguments="x:String">[strCategory]</OutArgument>
                          </Assign.To>
                          <Assign.Value>
                            <InArgument x:TypeArguments="x:String">["High Consumption"]</InArgument>
                          </Assign.Value>
                        </Assign>
                      </Sequence>
                    </If.Then>
                    <If.Else>
                      <Sequence DisplayName="Very High Consumption Branch" sap2010:WorkflowViewState.IdRef="Sequence_7">
                        <Assign DisplayName="Assign Bill - Very High" sap2010:WorkflowViewState.IdRef="Assign_8">
                          <Assign.To>
                            <OutArgument x:TypeArguments="x:Double">[dblBill]</OutArgument>
                          </Assign.To>
                          <Assign.Value>
                            <InArgument x:TypeArguments="x:Double">[intUnits * 7]</InArgument>
                          </Assign.Value>
                        </Assign>
                        <Assign DisplayName="Assign Category - Very High" sap2010:WorkflowViewState.IdRef="Assign_9">
                          <Assign.To>
                            <OutArgument x:TypeArguments="x:String">[strCategory]</OutArgument>
                          </Assign.To>
                          <Assign.Value>
                            <InArgument x:TypeArguments="x:String">["Very High Consumption"]</InArgument>
                          </Assign.Value>
                        </Assign>
                      </Sequence>
                    </If.Else>
                  </If>
                </If.Else>
              </If>
            </If.Else>
          </If>
          <ui:MessageBox Caption="{x:Null}" ChosenButton="{x:Null}" AutoCloseAfter="00:00:00" DisplayName="Message Box - Electricity Bill Result" sap2010:WorkflowViewState.IdRef="MessageBox_2" Text="[&quot;Units Consumed: &quot; &amp; intUnits.ToString &amp; vbCrLf &amp; &quot;Category: &quot; &amp; strCategory &amp; vbCrLf &amp; &quot;Electricity Bill: Rs. &quot; &amp; dblBill.ToString(&quot;F2&quot;)]" />
        </Sequence>
      </If.Else>
    </If>
  </Sequence>
</Activity>