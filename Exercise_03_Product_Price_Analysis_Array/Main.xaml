  <Sequence DisplayName="Main Sequence - Product Price Analysis" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="s:Double[]" Name="arrPrices" />
      <Variable x:TypeArguments="x:Double" Default="[0]" Name="dblTotal" />
      <Variable x:TypeArguments="x:Double" Default="[0]" Name="dblHighest" />
      <Variable x:TypeArguments="x:Double" Default="[0]" Name="dblLowest" />
    </Sequence.Variables>
    <Assign DisplayName="Initialize arrPrices" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="s:Double[]">[arrPrices]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="s:Double[]">[New Double() {1200, 850, 1500, 600, 950}]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Initialize dblTotal = 0" sap2010:WorkflowViewState.IdRef="Assign_2">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Double">[dblTotal]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Double">[0]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Initialize dblHighest" sap2010:WorkflowViewState.IdRef="Assign_3">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Double">[dblHighest]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Double">[arrPrices(0)]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Initialize dblLowest" sap2010:WorkflowViewState.IdRef="Assign_4">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Double">[dblLowest]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Double">[arrPrices(0)]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:ForEach x:TypeArguments="x:Double" CurrentIndex="{x:Null}" DisplayName="For Each Price in arrPrices" sap2010:WorkflowViewState.IdRef="ForEach_1" Values="[arrPrices]">
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="x:Double">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:Double" Name="CurrentItem" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <Assign DisplayName="Accumulate Total" sap2010:WorkflowViewState.IdRef="Assign_5">
              <Assign.To>
                <OutArgument x:TypeArguments="x:Double">[dblTotal]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:Double">[dblTotal + CurrentItem]</InArgument>
              </Assign.Value>
            </Assign>
            <If Condition="[CurrentItem &gt; dblHighest]" DisplayName="If CurrentItem &gt; dblHighest" sap2010:WorkflowViewState.IdRef="If_1">
              <If.Then>
                <Assign DisplayName="Update dblHighest" sap2010:WorkflowViewState.IdRef="Assign_6">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:Double">[dblHighest]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:Double">[CurrentItem]</InArgument>
                  </Assign.Value>
                </Assign>
              </If.Then>
            </If>
            <If Condition="[CurrentItem &lt; dblLowest]" DisplayName="If CurrentItem &lt; dblLowest" sap2010:WorkflowViewState.IdRef="If_2">
              <If.Then>
                <Assign DisplayName="Update dblLowest" sap2010:WorkflowViewState.IdRef="Assign_7">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:Double">[dblLowest]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:Double">[CurrentItem]</InArgument>
                  </Assign.Value>
                </Assign>
              </If.Then>
            </If>
          </Sequence>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
    <ui:MessageBox Caption="{x:Null}" ChosenButton="{x:Null}" AutoCloseAfter="00:00:00" DisplayName="Message Box - Price Analysis Results" sap2010:WorkflowViewState.IdRef="MessageBox_1" Text="[&quot;Product Price Analysis&quot; &amp; vbCrLf &amp; vbCrLf &amp; &quot;Total Cost: Rs. &quot; &amp; dblTotal.ToString(&quot;F2&quot;) &amp; vbCrLf &amp; &quot;Highest Price: Rs. &quot; &amp; dblHighest.ToString(&quot;F2&quot;) &amp; vbCrLf &amp; &quot;Lowest Price: Rs. &quot; &amp; dblLowest.ToString(&quot;F2&quot;)]" />
