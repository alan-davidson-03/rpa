  <Flowchart DisplayName="Flowchart - Simple Calculator" sap2010:WorkflowViewState.IdRef="Flowchart_1">
    <Flowchart.Variables>
      <Variable x:TypeArguments="x:String" Name="strInput" />
      <Variable x:TypeArguments="x:Double" Name="num1" />
      <Variable x:TypeArguments="x:Double" Name="num2" />
      <Variable x:TypeArguments="x:String" Name="strChoice" />
      <Variable x:TypeArguments="x:Double" Name="dblResult" />
      <Variable x:TypeArguments="x:String" Name="strMessage" />
    </Flowchart.Variables>
    <Flowchart.StartNode>
      <x:Reference>__ReferenceID0</x:Reference>
    </Flowchart.StartNode>
    <FlowStep x:Name="__ReferenceID0" sap2010:WorkflowViewState.IdRef="FlowStep_1">
      <Sequence DisplayName="Input Sequence" sap2010:WorkflowViewState.IdRef="Sequence_1">
        <ui:InputDialog Options="{x:Null}" OptionsString="{x:Null}" DisplayName="Input Dialog - First Number" sap2010:WorkflowViewState.IdRef="InputDialog_1" IsPassword="False" Label="Enter first number:" Title="Simple Calculator">
          <ui:InputDialog.Result>
            <OutArgument x:TypeArguments="x:String">[strInput]</OutArgument>
          </ui:InputDialog.Result>
        </ui:InputDialog>
        <Assign DisplayName="Convert num1" sap2010:WorkflowViewState.IdRef="Assign_1">
          <Assign.To>
            <OutArgument x:TypeArguments="x:Double">[num1]</OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="x:Double">[Convert.ToDouble(strInput)]</InArgument>
          </Assign.Value>
        </Assign>
        <ui:InputDialog Options="{x:Null}" OptionsString="{x:Null}" DisplayName="Input Dialog - Second Number" sap2010:WorkflowViewState.IdRef="InputDialog_2" IsPassword="False" Label="Enter second number:" Title="Simple Calculator">
          <ui:InputDialog.Result>
            <OutArgument x:TypeArguments="x:String">[strInput]</OutArgument>
          </ui:InputDialog.Result>
        </ui:InputDialog>
        <Assign DisplayName="Convert num2" sap2010:WorkflowViewState.IdRef="Assign_2">
          <Assign.To>
            <OutArgument x:TypeArguments="x:Double">[num2]</OutArgument>
          </Assign.To>
          <Assign.Value>
            <InArgument x:TypeArguments="x:Double">[Convert.ToDouble(strInput)]</InArgument>
          </Assign.Value>
        </Assign>
        <ui:InputDialog Options="{x:Null}" OptionsString="{x:Null}" DisplayName="Input Dialog - Operator" sap2010:WorkflowViewState.IdRef="InputDialog_3" IsPassword="False" Label="Choose operator (+, -, *, /):" Title="Simple Calculator">
          <ui:InputDialog.Result>
            <OutArgument x:TypeArguments="x:String">[strChoice]</OutArgument>
          </ui:InputDialog.Result>
        </ui:InputDialog>
      </Sequence>
      <FlowStep.Next>
        <FlowStep x:Name="__ReferenceID1" sap2010:WorkflowViewState.IdRef="FlowStep_2">
          <Sequence DisplayName="Switch Sequence" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <Switch x:TypeArguments="x:String" DisplayName="Switch on strChoice" Expression="[strChoice.Trim()]" sap2010:WorkflowViewState.IdRef="Switch_1">
              <Switch.Default>
                <Assign DisplayName="Default - Invalid Operator" sap2010:WorkflowViewState.IdRef="Assign_3">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:String">[strMessage]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">["Invalid operator"]</InArgument>
                  </Assign.Value>
                </Assign>
              </Switch.Default>
              <Sequence x:Key="+" DisplayName="Addition Case" sap2010:WorkflowViewState.IdRef="Sequence_3">
                <Assign DisplayName="Calculate Addition" sap2010:WorkflowViewState.IdRef="Assign_4">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:Double">[dblResult]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:Double">[num1 + num2]</InArgument>
                  </Assign.Value>
                </Assign>
                <Assign DisplayName="Message Addition" sap2010:WorkflowViewState.IdRef="Assign_5">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:String">[strMessage]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">["Result: " &amp; dblResult.ToString()]</InArgument>
                  </Assign.Value>
                </Assign>
              </Sequence>
              <Sequence x:Key="-" DisplayName="Subtraction Case" sap2010:WorkflowViewState.IdRef="Sequence_4">
                <Assign DisplayName="Calculate Subtraction" sap2010:WorkflowViewState.IdRef="Assign_6">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:Double">[dblResult]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:Double">[num1 - num2]</InArgument>
                  </Assign.Value>
                </Assign>
                <Assign DisplayName="Message Subtraction" sap2010:WorkflowViewState.IdRef="Assign_7">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:String">[strMessage]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">["Result: " &amp; dblResult.ToString()]</InArgument>
                  </Assign.Value>
                </Assign>
              </Sequence>
              <Sequence x:Key="*" DisplayName="Multiplication Case" sap2010:WorkflowViewState.IdRef="Sequence_5">
                <Assign DisplayName="Calculate Multiplication" sap2010:WorkflowViewState.IdRef="Assign_8">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:Double">[dblResult]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:Double">[num1 * num2]</InArgument>
                  </Assign.Value>
                </Assign>
                <Assign DisplayName="Message Multiplication" sap2010:WorkflowViewState.IdRef="Assign_9">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:String">[strMessage]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">["Result: " &amp; dblResult.ToString()]</InArgument>
                  </Assign.Value>
                </Assign>
              </Sequence>
              <Sequence x:Key="/" DisplayName="Division Case" sap2010:WorkflowViewState.IdRef="Sequence_6">
                <If Condition="[num2 &lt;&gt; 0]" DisplayName="If num2 &lt;&gt; 0" sap2010:WorkflowViewState.IdRef="If_1">
                  <If.Then>
                    <Sequence DisplayName="Valid Division" sap2010:WorkflowViewState.IdRef="Sequence_7">
                      <Assign DisplayName="Calculate Division" sap2010:WorkflowViewState.IdRef="Assign_10">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:Double">[dblResult]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:Double">[num1 / num2]</InArgument>
                        </Assign.Value>
                      </Assign>
                      <Assign DisplayName="Message Division" sap2010:WorkflowViewState.IdRef="Assign_11">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:String">[strMessage]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:String">["Result: " &amp; dblResult.ToString()]</InArgument>
                        </Assign.Value>
                      </Assign>
                    </Sequence>
                  </If.Then>
                  <If.Else>
                    <Sequence DisplayName="Divide by Zero" sap2010:WorkflowViewState.IdRef="Sequence_8">
                      <Assign DisplayName="Message Zero Error" sap2010:WorkflowViewState.IdRef="Assign_12">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:String">[strMessage]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:String">["Cannot divide by zero"]</InArgument>
                        </Assign.Value>
                      </Assign>
                    </Sequence>
                  </If.Else>
                </If>
              </Sequence>
            </Switch>
          </Sequence>
          <FlowStep.Next>
            <FlowStep x:Name="__ReferenceID2" sap2010:WorkflowViewState.IdRef="FlowStep_3">
              <ui:MessageBox Caption="{x:Null}" ChosenButton="{x:Null}" AutoCloseAfter="00:00:00" DisplayName="Message Box - Calculator Result" sap2010:WorkflowViewState.IdRef="MessageBox_1" Text="[strMessage]" />
            </FlowStep>
          </FlowStep.Next>
        </FlowStep>
      </FlowStep.Next>
    </FlowStep>
    <x:Reference>__ReferenceID1</x:Reference>
    <x:Reference>__ReferenceID2</x:Reference>
  </Flowchart>
