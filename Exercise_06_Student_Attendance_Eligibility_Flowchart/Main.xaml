  <Flowchart DisplayName="Flowchart - Attendance Eligibility" sap2010:WorkflowViewState.IdRef="Flowchart_1">
    <Flowchart.Variables>
      <Variable x:TypeArguments="x:String" Name="strAttendance" />
      <Variable x:TypeArguments="x:Double" Name="dblAttendance" />
      <Variable x:TypeArguments="x:String" Name="strResult" />
    </Flowchart.Variables>
    <Flowchart.StartNode>
      <x:Reference>__ReferenceID0</x:Reference>
    </Flowchart.StartNode>
    <FlowStep x:Name="__ReferenceID0" sap2010:WorkflowViewState.IdRef="FlowStep_1">
      <ui:InputDialog Options="{x:Null}" OptionsString="{x:Null}" DisplayName="Input Dialog - Attendance Percentage" sap2010:WorkflowViewState.IdRef="InputDialog_1" IsPassword="False" Label="Enter attendance percentage" Title="Student Attendance Eligibility">
        <ui:InputDialog.Result>
          <OutArgument x:TypeArguments="x:String">[strAttendance]</OutArgument>
        </ui:InputDialog.Result>
      </ui:InputDialog>
      <FlowStep.Next>
        <FlowStep x:Name="__ReferenceID1" sap2010:WorkflowViewState.IdRef="FlowStep_2">
          <Assign DisplayName="Convert to Double" sap2010:WorkflowViewState.IdRef="Assign_1">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Double">[dblAttendance]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Double">[Convert.ToDouble(strAttendance)]</InArgument>
            </Assign.Value>
          </Assign>
          <FlowStep.Next>
            <FlowDecision x:Name="__ReferenceID2" Condition="[dblAttendance &gt;= 0 AndAlso dblAttendance &lt;= 100]" DisplayName="Valid Range (0-100)?" sap2010:WorkflowViewState.IdRef="FlowDecision_1">
              <FlowDecision.True>
                <FlowDecision x:Name="__ReferenceID3" Condition="[dblAttendance &gt;= 75]" DisplayName="Attendance &gt;= 75%?" sap2010:WorkflowViewState.IdRef="FlowDecision_2">
                  <FlowDecision.True>
                    <FlowStep x:Name="__ReferenceID4" sap2010:WorkflowViewState.IdRef="FlowStep_3">
                      <Assign DisplayName="Assign Eligible" sap2010:WorkflowViewState.IdRef="Assign_2">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:String">[strResult]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:String">["Eligible for Examination"]</InArgument>
                        </Assign.Value>
                      </Assign>
                      <FlowStep.Next>
                        <FlowStep x:Name="__ReferenceID5" sap2010:WorkflowViewState.IdRef="FlowStep_4">
                          <ui:MessageBox Caption="{x:Null}" ChosenButton="{x:Null}" AutoCloseAfter="00:00:00" DisplayName="Message Box - Attendance Result" sap2010:WorkflowViewState.IdRef="MessageBox_1" Text="[strResult]" />
                        </FlowStep>
                      </FlowStep.Next>
                    </FlowStep>
                  </FlowDecision.True>
                  <FlowDecision.False>
                    <FlowStep x:Name="__ReferenceID6" sap2010:WorkflowViewState.IdRef="FlowStep_5">
                      <Assign DisplayName="Assign Not Eligible" sap2010:WorkflowViewState.IdRef="Assign_3">
                        <Assign.To>
                          <OutArgument x:TypeArguments="x:String">[strResult]</OutArgument>
                        </Assign.To>
                        <Assign.Value>
                          <InArgument x:TypeArguments="x:String">["Not Eligible for Examination"]</InArgument>
                        </Assign.Value>
                      </Assign>
                      <FlowStep.Next>
                        <x:Reference>__ReferenceID5</x:Reference>
                      </FlowStep.Next>
                    </FlowStep>
                  </FlowDecision.False>
                </FlowDecision>
              </FlowDecision.True>
              <FlowDecision.False>
                <FlowStep x:Name="__ReferenceID7" sap2010:WorkflowViewState.IdRef="FlowStep_6">
                  <ui:MessageBox Caption="{x:Null}" ChosenButton="{x:Null}" AutoCloseAfter="00:00:00" DisplayName="Message Box - Invalid Range" sap2010:WorkflowViewState.IdRef="MessageBox_2" Text="[&quot;Invalid Attendance Percentage&quot;]" />
                </FlowStep>
              </FlowDecision.False>
            </FlowDecision>
          </FlowStep.Next>
        </FlowStep>
      </FlowStep.Next>
    </FlowStep>
