  <Sequence DisplayName="Main Sequence - Password Validation" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="strPassword" />
      <Variable x:TypeArguments="x:String" Default="[&quot;RPA123&quot;]" Name="strCorrectPassword" />
      <Variable x:TypeArguments="x:Int32" Default="[0]" Name="intAttempts" />
      <Variable x:TypeArguments="x:Boolean" Default="[False]" Name="boolValid" />
    </Sequence.Variables>
    <Assign DisplayName="Initialize strCorrectPassword" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[strCorrectPassword]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">["RPA123"]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Initialize intAttempts = 0" sap2010:WorkflowViewState.IdRef="Assign_2">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Int32">[intAttempts]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Int32">[0]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Initialize boolValid = False" sap2010:WorkflowViewState.IdRef="Assign_3">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Boolean">[boolValid]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Boolean">[False]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:InterruptibleDoWhile CurrentIndex="{x:Null}" Condition="[Not boolValid AndAlso intAttempts &lt; 3]" DisplayName="Do While Password Validation" sap2010:WorkflowViewState.IdRef="InterruptibleDoWhile_1">
      <ui:InterruptibleDoWhile.Body>
        <Sequence DisplayName="Loop Body" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <ui:InputDialog Options="{x:Null}" OptionsString="{x:Null}" DisplayName="Input Dialog - Password" sap2010:WorkflowViewState.IdRef="InputDialog_1" IsPassword="False" Label="Enter Password" Title="Password Validation">
            <ui:InputDialog.Result>
              <OutArgument x:TypeArguments="x:String">[strPassword]</OutArgument>
            </ui:InputDialog.Result>
          </ui:InputDialog>
          <Assign DisplayName="Increment intAttempts" sap2010:WorkflowViewState.IdRef="Assign_4">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Int32">[intAttempts]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Int32">[intAttempts + 1]</InArgument>
            </Assign.Value>
          </Assign>
          <If Condition="[strPassword = strCorrectPassword]" DisplayName="If Password Matches" sap2010:WorkflowViewState.IdRef="If_1">
            <If.Then>
              <Sequence DisplayName="Correct Password" sap2010:WorkflowViewState.IdRef="Sequence_3">
                <Assign DisplayName="Set boolValid = True" sap2010:WorkflowViewState.IdRef="Assign_5">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:Boolean">[boolValid]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:Boolean">[True]</InArgument>
                  </Assign.Value>
                </Assign>
                <ui:MessageBox Caption="{x:Null}" ChosenButton="{x:Null}" AutoCloseAfter="00:00:00" DisplayName="Message Box - Success" sap2010:WorkflowViewState.IdRef="MessageBox_1" Text="[&quot;Login Successful&quot;]" />
              </Sequence>
            </If.Then>
            <If.Else>
              <Sequence DisplayName="Incorrect Password" sap2010:WorkflowViewState.IdRef="Sequence_4">
                <ui:MessageBox Caption="{x:Null}" ChosenButton="{x:Null}" AutoCloseAfter="00:00:00" DisplayName="Message Box - Incorrect" sap2010:WorkflowViewState.IdRef="MessageBox_2" Text="[&quot;Incorrect Password&quot;]" />
              </Sequence>
            </If.Else>
          </If>
        </Sequence>
      </ui:InterruptibleDoWhile.Body>
    </ui:InterruptibleDoWhile>
    <If Condition="[Not boolValid]" DisplayName="If Not boolValid" sap2010:WorkflowViewState.IdRef="If_2">
      <If.Then>
        <ui:MessageBox Caption="{x:Null}" ChosenButton="{x:Null}" AutoCloseAfter="00:00:00" DisplayName="Message Box - Access Denied" sap2010:WorkflowViewState.IdRef="MessageBox_3" Text="[&quot;Maximum Attempts Reached. Access Denied.&quot;]" />
      </If.Then>
    </If>
  </Sequence>
