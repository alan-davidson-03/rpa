  <Sequence DisplayName="Main Sequence - Student Result Analysis" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataTable" Name="dtStudents" />
      <Variable x:TypeArguments="x:Int32" Default="[0]" Name="intPass" />
      <Variable x:TypeArguments="x:Int32" Default="[0]" Name="intFail" />
      <Variable x:TypeArguments="x:Int32" Default="[0]" Name="intMarks" />
